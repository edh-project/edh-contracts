{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://edh-project.github.io/contracts/lifecycle/event.schema.json",
  "title":"EDH Run Lifecycle Event",
  "type":"object","additionalProperties":false,
  "required":["schema_version","ts","type","run_id","plan_id","task_id","status","phase","message"],
  "properties":{
    "schema_version":{"const":"1.0"},"ts":{"type":"string","format":"date-time"},"type":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},"plan_id":{"type":["string","null"]},"task_id":{"type":["string","null"]},
    "status":{"type":"string","minLength":1},"phase":{"type":"string","minLength":1},"message":{"type":"string"}
  }
}
